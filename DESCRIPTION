RoxygenNote: 7.3.3
Depends:
    R (>= 4.2.0)
Imports:
    cowplot,
    ggplot2,
    MASS,
    plotgardener,
    scales,
    yaml
Suggests:
    testthat (>= 3.0.0),
    withr
Config/testthat/edition: 3
